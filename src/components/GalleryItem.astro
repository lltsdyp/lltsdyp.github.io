---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  bigTitle: string;
  date: Date;
  emphasis?: string;
  headline: string;
  cover: string;
  author: string;
  excerpt: string;
}

const { bigTitle, date, emphasis, headline, cover, author, excerpt } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(date)
  .replaceAll('/', '.');

const parts = emphasis ? headline.split('{emphasis}') : [headline];
---

<div class="blog-header">
  <div class="blog-article header-article">
    <div class="blog-big__title">{bigTitle}</div>
    <div class="blog-menu small-title date">{formatted}</div>
  </div>
  <div class="blog-article">
    <ResponsiveImage src={cover} width={1600} height={900} alt={bigTitle} loading="eager" />
    <h2>
      {
        emphasis ? (
          <>
            {parts[0]}
            <span>{emphasis}</span>
            {parts[1]}
          </>
        ) : (
          headline
        )
      }
    </h2>
    <div class="blog-detail">
      <span>By {author}</span>
    </div>
    <p>{excerpt}</p>
  </div>
</div>
