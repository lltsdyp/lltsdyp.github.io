---
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  bigTitle: string;
  emphasis?: string;
  headline: string;
  cover: ImageMetadata | string;
}

const { bigTitle, emphasis, headline, cover } = Astro.props;

const parts = emphasis ? headline.split('{emphasis}') : [headline];
---

<div class="blog-header">
  <div class="blog-article header-article">
    <div class="blog-big__title">{bigTitle}</div>
    <div class="gallery-header-divider" aria-hidden="true"></div>
  </div>
  <div class="blog-article">
    <ResponsiveImage src={cover} width={1600} height={900} alt={bigTitle} loading="eager" />
    <h2>
      {
        emphasis ? (
          <>
            {parts[0]}
            <span>{emphasis}</span>
            {parts[1]}
          </>
        ) : (
          headline
        )
      }
    </h2>
    <div class="prose gallery-body">
      <slot />
    </div>
  </div>
</div>
