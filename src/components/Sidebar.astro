---
import Marquee from './Marquee.astro';
import Circle from './Circle.astro';

interface Entry {
  id: string;
  data: {
    title: string;
    excerpt: string;
    date: Date;
  };
}

interface Props {
  entries: Entry[];
  heading?: string;
  seeAllHref?: string;
}

const { entries, heading = 'Recent Blogs', seeAllHref } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const sorted = [...entries].sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---

<div class="blog-part right-blog">
  <Marquee />
  <div class="blog-right-title-container">
    <div class="blog-right-title">{heading}</div>
    {
      seeAllHref && (
        <a href={seeAllHref} class="blog-menu rounded">
          See All
        </a>
      )
    }
  </div>
  <div class="blog-right">
    {
      sorted.map((e, index) => (
        <a class="blog-right-container" href={`/blog/${e.id}`}>
          <div class="blog-title-date">
            <div class="blog-right-page">{index + 1}</div>
            <div class="date">{fmt(e.data.date)}</div>
          </div>
          <div class="blog-right-page-title">{e.data.title}</div>
          <div class="blog-right-page-subtitle">{e.data.excerpt}</div>
        </a>
      ))
    }
    <Circle />
  </div>
</div>
