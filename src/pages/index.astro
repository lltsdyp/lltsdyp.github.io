---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import StickyHeader from '../components/StickyHeader.astro';
import GalleryItem from '../components/GalleryItem.astro';
import Sidebar from '../components/Sidebar.astro';

const gallery = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = await getCollection('featured');

const pageNumber = gallery.find((item) => item.data.pageNumber)?.data.pageNumber ?? 'NO. 01';
---

<BaseLayout>
  <div class="blog">
    <Menu />
    <StickyHeader title="I'm" pinnedLabel="Hi, there!" pageNumber={pageNumber} />

    <div class="blog-header-container">
      {
        gallery.map((item) => (
          <GalleryItem
            bigTitle={item.data.bigTitle}
            date={item.data.date}
            emphasis={item.data.emphasis}
            headline={item.data.headline}
            cover={item.data.cover}
            author={item.data.author}
            excerpt={item.data.excerpt}
          />
        ))
      }
    </div>

    <Sidebar entries={featured} />
  </div>
</BaseLayout>
