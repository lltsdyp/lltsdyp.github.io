---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import StickyHeader from '../components/StickyHeader.astro';
import GalleryItem from '../components/GalleryItem.astro';
import Sidebar from '../components/Sidebar.astro';

const gallery = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const galleryWithContent = await Promise.all(
  gallery.map(async (item) => ({
    item,
    Content: (await render(item)).Content,
  })),
);
const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const pageNumber = gallery.find((item) => item.data.pageNumber)?.data.pageNumber ?? 'NO. 01';
---

<BaseLayout title="Zimo's Homepage">
  <div class="blog">
    <Menu />
    <StickyHeader title="I'm" pinnedLabel="Hi, there!" pageNumber={pageNumber} />

    <div class="blog-header-container">
      {
        galleryWithContent.map(({ item, Content }) => (
          <GalleryItem
            bigTitle={item.data.bigTitle}
            emphasis={item.data.emphasis}
            headline={item.data.headline}
            cover={item.data.cover}
          >
            <Content />
          </GalleryItem>
        ))
      }
    </div>

    <Sidebar entries={recentPosts} heading="Recent Blogs" />
  </div>
</BaseLayout>
